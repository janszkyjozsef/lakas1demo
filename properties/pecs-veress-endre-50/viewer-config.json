  "poi": [
    {
      "title": "A nagy szoba",
      "position": [
        -2,
        1.1,
        -1.7
      ],
      "p": [
        -0.55,
        1.72,
        -0.67
      ],
      "t": [
        -4.43,
        1.07,
        -2.32
      ],
      "text": "Üres, külön nyíló szoba. A fotón látható taupe fal és világos háromszögfestés, sötétbarna padló, redőny és radiátor alapján.",
      "view_index": 2,
      "fov": 45.74733038125343
    },
    {
      "title": "A sárga szoba",
      "position": [
        3.35,
        1.1,
        -1.7
      ],
      "p": [
        2.07,
        1.79,
        -0.56
      ],
      "t": [
        4.92,
        1.22,
        -2.28
      ],
      "text": "Üres, külön nyíló szoba a forrás sárga falaival, barna padlóval és fehér ablakával.",
      "view_index": 4,
      "fov": 39.76070472928529
    },
    {
      "title": "A konyha",
      "position": [
        3.8,
        1.1,
        2.2
      ],
      "p": [
        1.91,
        1.7,
        2.7
      ],
      "t": [
        4.18,
        1.13,
        2.18
      ],
      "text": "A forrás bézs és fa szekrényfrontjai, fehér gombjai, sötét munkalapja, süllyesztett acélmosogatója és piros lehajtható asztala.",
      "view_index": 5,
      "fov": 39.76070472928529
    },
    {
      "title": "A fürdő",
      "position": [
        4.65,
        1.1,
        0.65
      ],
      "p": [
        3.13,
        1.66,
        0.55
      ],
      "t": [
        4.93,
        1.17,
        0.54
      ],
      "text": "Krém és barna burkolatok, üveg zuhanyfülke és valóban bemélyedő fehér mosdó.",
      "view_index": 6,
      "fov": 42.55417341315535
    },
    {
      "title": "A közlekedő",
      "position": [
        0.75,
        1.1,
        1.84
      ],
      "p": [
        0.77,
        1.72,
        0.27
      ],
      "t": [
        0.76,
        1.1,
        3.55
      ],
      "text": "Nyitott ajtókeretek. A lakásba nem került belső lépcső; a lépcsőházi képek a közös épületrészt mutatják.",
      "view_index": 7,
      "fov": 45.74733038125343
    },
    {
      "title": "Külön WC",
      "position": [
        2.02,
        0.7,
        1.33
      ],
      "p": [
        11,
        12,
        12
      ],
      "t": [
        0,
        0.8,
        0
      ],
      "text": "Az alaprajzon külön WC szerepel. Belső fotó nem áll rendelkezésre, ezért berendezését nem találtuk ki.",
      "view_index": 0
    }
