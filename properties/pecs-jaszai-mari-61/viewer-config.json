  "poi": [
    {
      "title": "Nappali",
      "position": [
        -2.845,
        1.1,
        1.93
      ],
      "p": [
        -1.91,
        1.68,
        2.89
      ],
      "t": [
        -3.79,
        1.15,
        0.94
      ],
      "fov": 49.42635376093179,
      "reference_aspect": 1.7777777777777777,
      "view_index": 1,
      "text": "Két eredeti szürke fotel, üvegasztal, zöld mintás szőnyeg és barna TV-komód."
    },
    {
      "title": "Könyvesfal és kék kanapé",
      "position": [
        -2.9,
        1.45,
        3.4
      ],
      "p": [
        -4.03,
        1.69,
        0.56
      ],
      "t": [
        -2.8,
        1.23,
        3.45
      ],
      "fov": 49.42635376093179,
      "reference_aspect": 1.7777777777777777,
      "view_index": 2,
      "text": "A régebbi, igazoltan azonos lakást mutató fotó könyvesfala, kék kanapéja és klímája."
    },
    {
      "title": "Hálószoba",
      "position": [
        -3.42,
        0.95,
        -2.27
      ],
      "p": [
        -2.75,
        1.7,
        -0.58
      ],
      "t": [
        -3.495,
        1.18,
        -2.7
      ],
      "fov": 47.519857963653635,
      "reference_aspect": 1.7777777777777777,
      "view_index": 3,
      "text": "Eredeti faágy fehér bevetett takaróval és virágmintás párnákkal; fa és sötétcsíkos tolóajtós szekrény."
    },
    {
      "title": "Hall és étkező",
      "position": [
        3.26,
        1.08,
        0
      ],
      "p": [
        0.38,
        1.67,
        -0.93
      ],
      "t": [
        3.5,
        1.05,
        0.05
      ],
      "fov": 45.74733038125343,
      "reference_aspect": 1.7777777777777777,
      "view_index": 4,
      "text": "L alakú hall és négy székes fa étkező. A forrás gázkonvektora és füstcsöve megmaradt."
    },
    {
      "title": "Külön konyha",
      "position": [
        3.28,
        1.15,
        2.61
      ],
      "p": [
        1.78,
        1.66,
        1.79
      ],
      "t": [
        3.81,
        1.2,
        2.46
      ],
      "fov": 44.09589492712077,
      "reference_aspect": 1.7777777777777777,
      "view_index": 5,
      "text": "Külön konyha két fabútorsorral, süllyesztett acélmosogatóval, tűzhellyel és a valós narancsszínű telepített készülékkel."
    },
    {
      "title": "Fürdőszoba",
      "position": [
        -0.45,
        1.1,
        -2.75
      ],
      "p": [
        -0.5,
        1.65,
        -1.67
      ],
      "t": [
        -0.45,
        1.18,
        -2.75
      ],
      "fov": 58.71550708558255,
      "reference_aspect": 1.7777777777777777,
      "view_index": 6,
      "text": "A forrás álló mosdója, bemélyedő kádja és lecsukott mosógépe, eredeti krém burkolattal."
    },
    {
      "title": "Külön WC",
      "position": [
        3.81,
        0.9,
        -3.19
      ],
      "p": [
        3.7,
        1.65,
        -1.78
      ],
      "t": [
        3.83,
        1.04,
        -3.32
      ],
      "fov": 47.519857963653635,
      "reference_aspect": 1.7777777777777777,
      "view_index": 7,
      "text": "Külön WC a forrás tartályával, lefolyócsövével és vízmérőjével."
    },
    {
      "title": "Kamra",
      "position": [
        2.0,
        1.25,
        3.3
      ],
      "p": [
        0.35,
        1.35,
        3.6
      ],
      "t": [
        1.93,
        1.3,
        3.28
      ],
      "fov": 71.74998270412806,
      "reference_aspect": 1.7777777777777777,
      "view_index": 8,
      "text": "A rendezett kamra eredeti üres polcai és sárga felső szekrénye; a modell az eredeti alaprajz nyílásait követi."
    }
